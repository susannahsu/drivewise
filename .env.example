# Copy to .env.local and fill in. Both are free to obtain.

# U.S. Energy Information Administration — electricity & gas prices
# Get one: https://www.eia.gov/opendata/
EIA_API_KEY=

# FRED (St. Louis Fed) — auto-loan interest rates
# Get one: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Auto.dev — live dealer listings for the "compare dealers" feature
# Free tier: 1,000 lookups/mo. Get one: https://www.auto.dev/
AUTO_DEV_API_KEY=
